<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Adrián Taberna, arquitecto en Buenos Aires. Arquitectura, documentación técnica, mobiliario y coordinación de producción.">
  <meta name="theme-color" content="#25221f">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_AR">
  <meta property="og:title" content="Adrián Taberna — Arquitectura, detalle y producción">
  <meta property="og:description" content="Arquitectura, documentación técnica, mobiliario y coordinación de producción en Buenos Aires.">
  <meta property="og:site_name" content="Adrián Taberna · Arquitecto">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Adrián Taberna — Arquitectura, detalle y producción">
  <meta name="twitter:description" content="Proyectos pensados desde el espacio hasta su materialización.">
  <title>Adrián Taberna — Arquitectura, detalle y producción</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23100f0e'/%3E%3Cpath d='M13 49 30 13h4l17 36h-8l-4-9H25l-4 9Zm15-16h8l-4-10Z' fill='%23f2efe9'/%3E%3C/svg%3E">
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Person","name":"Adrián Taberna","jobTitle":"Arquitecto","address":{"@type":"PostalAddress","addressLocality":"Buenos Aires","addressCountry":"AR"},"email":"mailto:arq.adrian.taberna@gmail.com","sameAs":["https://www.linkedin.com/in/adrian-taberna-/"],"knowsAbout":["Arquitectura","Documentación técnica","Diseño de mobiliario","Coordinación de producción"]}
  </script>
  <style>
    :root{
      --ink:#100f0e;--paper:#f2efe9;--soft:#e5e0d8;--accent:#a64b32;
      --muted:#68635d;--line:#cbc4ba;--max:1440px;--pad:clamp(22px,4vw,64px)
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5}
    body:has(.mobile-menu[open]){overflow:hidden}
    img{display:block;width:100%;height:100%;object-fit:cover}
    a{color:inherit;text-decoration:none}
    button,summary{font:inherit}
    ::selection{background:var(--accent);color:white}
    .shell{width:min(calc(100% - (var(--pad) * 2)),var(--max));margin-inline:auto}
    .kicker{font-size:.75rem;line-height:1.2;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .skip-link{position:fixed;z-index:100;left:18px;top:12px;padding:12px 16px;background:var(--ink);color:var(--paper);transform:translateY(-160%);transition:transform .2s}
    .skip-link:focus{transform:translateY(0)}
    section,article{scroll-margin-top:78px}

    .site-nav{position:fixed;z-index:40;inset:0 0 auto;background:rgba(242,239,233,.94);border-bottom:1px solid rgba(16,15,14,.18);backdrop-filter:blur(14px)}
    .nav-inner{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{font-size:.82rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
    .desktop-nav{display:flex;align-items:center;gap:30px;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
    .desktop-nav a{position:relative;padding:8px 0}
    .desktop-nav a:after{content:"";position:absolute;left:0;right:100%;bottom:2px;height:1px;background:currentColor;transition:right .25s ease}
    .desktop-nav a:hover:after,.desktop-nav a:focus-visible:after{right:0}
    .nav-contact{padding:11px 15px!important;border:1px solid var(--ink)}
    .nav-contact:after{display:none}
    .mobile-menu{display:none}

    .hero{position:relative;min-height:92svh;background:#181715;color:white;overflow:hidden}
    .hero-media{position:absolute;inset:0}
    .hero-media img{object-position:center 55%}
    .hero-media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,8,7,.78) 0%,rgba(8,8,7,.37) 47%,rgba(8,8,7,.10) 78%),linear-gradient(0deg,rgba(8,8,7,.62),transparent 54%)}
    .hero-inner{position:relative;z-index:1;min-height:92svh;padding-top:150px;padding-bottom:58px;display:flex;flex-direction:column;justify-content:space-between}
    .hero-top{display:flex;justify-content:space-between;gap:24px;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:#eeeae3}
    .hero-copy{max-width:1060px}
    .hero h1{margin:0;max-width:980px;font-size:clamp(4.35rem,10.5vw,10.4rem);font-weight:400;line-height:.79;letter-spacing:-.07em}
    .hero h1 em{display:block;font-family:Georgia,"Times New Roman",serif;font-weight:400;color:#d5c8bb}
    .hero-bottom{display:grid;grid-template-columns:minmax(0,1fr) 310px;align-items:end;gap:56px;margin-top:52px}
    .hero-lead{margin:0;max-width:730px;font-size:clamp(1.3rem,2.15vw,2.05rem);line-height:1.15;letter-spacing:-.025em}
    .hero-note{margin:0;color:#ddd7cf;font-size:.95rem}
    .text-link{display:inline-flex;align-items:center;gap:12px;margin-top:28px;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:7px}
    .text-link span{transition:transform .2s ease}.text-link:hover span{transform:translateX(4px)}

    .manifesto{padding:clamp(82px,11vw,168px) 0;border-bottom:1px solid var(--line)}
    .manifesto-grid{display:grid;grid-template-columns:minmax(150px,.32fr) minmax(0,1fr);gap:clamp(38px,7vw,118px)}
    .manifesto h2{margin:0;max-width:1080px;font-size:clamp(2.55rem,6vw,6.6rem);font-weight:400;line-height:.95;letter-spacing:-.055em}
    .manifesto h2 em{font-family:Georgia,"Times New Roman",serif;font-weight:400}
    .manifesto-copy{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;margin-top:64px;max-width:1020px}
    .manifesto-copy p{margin:0;font-size:1.08rem;color:#373431}
    .manifesto-copy .large{font-size:clamp(1.35rem,2.2vw,2.05rem);line-height:1.2;letter-spacing:-.025em;color:var(--ink)}

    .work-head{padding:clamp(80px,9vw,138px) 0 54px;display:flex;align-items:end;justify-content:space-between;gap:30px}
    .work-head h2{margin:14px 0 0;font-size:clamp(2.7rem,6vw,6.3rem);font-weight:400;line-height:.9;letter-spacing:-.055em}
    .work-head p{max-width:390px;margin:0;color:var(--muted)}
    .project{border-top:1px solid var(--ink);padding:28px 0 clamp(92px,12vw,170px)}
    .project-heading{display:grid;grid-template-columns:80px minmax(0,1fr) 300px;align-items:start;gap:26px;margin-bottom:34px}
    .project-index{font-family:Georgia,"Times New Roman",serif;font-size:1.35rem;color:var(--accent)}
    .project h3{margin:0;font-size:clamp(2.65rem,5.8vw,6.8rem);font-weight:400;line-height:.85;letter-spacing:-.06em}
    .project-tag{padding-top:8px;font-size:.75rem;letter-spacing:.11em;text-transform:uppercase;color:var(--muted)}
    .project-cover{aspect-ratio:1.75/1;overflow:hidden;background:#ccc}
    .project-cover img{transition:transform .8s cubic-bezier(.22,.61,.36,1)}
    .project:hover .project-cover img{transform:scale(1.018)}
    .project-summary{display:grid;grid-template-columns:1fr 1fr;gap:clamp(42px,8vw,120px);padding:42px 0 0}
    .project-summary .statement{margin:0;font-size:clamp(1.4rem,2.35vw,2.25rem);line-height:1.17;letter-spacing:-.025em}
    .project-data{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
    .datum{padding:15px 0;border-bottom:1px solid var(--line)}
    .datum:nth-child(odd){padding-right:18px}
    .datum small{display:block;margin-bottom:3px;color:var(--muted);font-size:.7rem;letter-spacing:.11em;text-transform:uppercase}
    .datum span{font-size:.92rem}
    .case-file{margin-top:35px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}
    .case-file>summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:18px 0;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
    .case-file>summary::-webkit-details-marker{display:none}
    .case-file>summary:after{content:"+";font-size:1.5rem;font-weight:300;line-height:1}
    .case-file[open]>summary:after{content:"−"}
    .case-content{padding:22px 0 38px}
    .case-intro{display:grid;grid-template-columns:.55fr 1fr;gap:50px;padding:18px 0 44px}
    .case-intro h4{margin:0;font-size:1.05rem;font-weight:500}
    .case-intro p{margin:0;max-width:760px;font-size:1.03rem;color:#3f3b37}
    .story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-bottom:38px;background:var(--line);border:1px solid var(--line)}
    .story-item{min-height:180px;padding:22px;background:var(--paper)}
    .story-item small{display:block;margin-bottom:30px;color:var(--accent);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}
    .story-item p{margin:0;color:#3f3b37;font-size:.94rem}
    .technical-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .technical-image{aspect-ratio:1.28/1;background:#f8f6f2;border:1px solid var(--line);overflow:hidden}
    .technical-image img{object-fit:contain;padding:18px}
    .technical-image.technical-render img{object-fit:cover;padding:0}
    .technical-grid figure{margin:0}.technical-grid figcaption{margin-top:9px;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}

    .project-gallery-label{display:grid;grid-template-columns:.55fr 1fr;gap:50px;margin:56px 0 20px;padding-top:18px;border-top:1px solid var(--line)}
    .project-gallery-label span{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
    .project-gallery-label p{margin:0;color:#3f3b37;font-size:.94rem}
    .project-gallery{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .project-gallery figure{margin:0}.project-gallery figure:first-child{grid-column:1/-1}
    .project-gallery-media{aspect-ratio:1.78/1;overflow:hidden;background:#d8d4ce}
    .project-gallery img{width:100%;height:100%;object-fit:cover}
    .project-gallery figcaption{margin-top:9px;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}

    .mid-cta{background:var(--accent);color:white;padding:clamp(54px,7vw,92px) 0}
    .mid-cta-inner{display:grid;grid-template-columns:1fr auto;align-items:end;gap:45px}
    .mid-cta h2{margin:12px 0 0;max-width:930px;font-size:clamp(2.2rem,4.7vw,5.2rem);font-weight:400;line-height:.94;letter-spacing:-.05em}
    .mid-cta .kicker{color:#f0c7bb}.mid-cta .text-link{margin:0;white-space:nowrap}

    .credibility{padding:27px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .credibility-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .credibility-item{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
    .credibility-item span{display:block;margin-bottom:4px;color:var(--muted);font-size:.67rem}

    .furniture{position:relative;background:var(--ink);color:var(--paper);padding:clamp(90px,11vw,165px) 0;overflow:hidden}
    .furniture:before{content:"M";position:absolute;right:-.04em;top:-.18em;font-family:Georgia,"Times New Roman",serif;font-size:min(54vw,790px);line-height:1;color:#191816;pointer-events:none}
    .furniture-inner{position:relative;z-index:1}
    .furniture .kicker{color:#a8a098}
    .furniture h2{margin:20px 0 0;max-width:1050px;font-size:clamp(3.2rem,7.8vw,8.2rem);font-weight:400;line-height:.86;letter-spacing:-.065em}
    .furniture h2 em{font-family:Georgia,"Times New Roman",serif;font-weight:400;color:#c9b6a6}
    .furniture-lead{display:grid;grid-template-columns:1fr .72fr;gap:clamp(44px,10vw,150px);margin-top:76px;padding-top:25px;border-top:1px solid #47423d}
    .furniture-lead p{margin:0;font-size:clamp(1.35rem,2.2vw,2rem);line-height:1.2;max-width:720px}
    .furniture-lead .side{font-size:1rem;color:#bdb6ae;max-width:460px}
    .furniture-services{display:grid;grid-template-columns:repeat(3,1fr);margin-top:86px;border-top:1px solid #47423d;border-left:1px solid #47423d}
    .furniture-service{min-height:270px;padding:26px;border-right:1px solid #47423d;border-bottom:1px solid #47423d;display:flex;flex-direction:column;justify-content:space-between}
    .furniture-service small{color:#918880;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
    .furniture-service h3{margin:0 0 13px;font-size:1.75rem;font-weight:400;letter-spacing:-.03em}
    .furniture-service p{margin:0;color:#aaa39c;font-size:.95rem}
    .furniture-list{display:grid;grid-template-columns:.35fr 1fr;margin-top:48px;padding-top:19px;border-top:1px solid #47423d}
    .furniture-list p{margin:0;color:#c8c1ba;text-transform:uppercase;letter-spacing:.08em;font-size:.78rem}

    .notebook{position:relative;padding:clamp(92px,12vw,180px) 0;background:#dcd6cd;overflow:hidden}
    .notebook:after{content:"CUADERNO";position:absolute;left:var(--pad);bottom:-.27em;font-family:Georgia,"Times New Roman",serif;font-size:min(19vw,270px);line-height:1;color:rgba(16,15,14,.045);letter-spacing:-.07em;pointer-events:none}
    .notebook-inner{position:relative;z-index:1}
    .notebook-head{display:grid;grid-template-columns:.34fr 1fr;gap:clamp(42px,8vw,120px);align-items:start}
    .notebook h2{margin:0;max-width:980px;font-size:clamp(3.2rem,7vw,7.5rem);font-weight:400;line-height:.87;letter-spacing:-.065em}
    .notebook h2 em{display:block;font-family:Georgia,"Times New Roman",serif;font-weight:400;color:var(--accent)}
    .notebook-intro{display:grid;grid-template-columns:1fr .8fr;gap:clamp(32px,7vw,100px);margin:65px 0 75px;padding-top:22px;border-top:1px solid var(--ink)}
    .notebook-intro .lead{margin:0;font-size:clamp(1.35rem,2.25vw,2.05rem);line-height:1.2;letter-spacing:-.025em}
    .notebook-intro .side{margin:0;color:#4f4a44}
    .note-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink);border-left:1px solid var(--ink)}
    .note-card{min-height:310px;padding:26px;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--ink);border-bottom:1px solid var(--ink)}
    .note-card small{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#625d57}
    .note-card h3{margin:0 0 13px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.6rem,2.5vw,2.35rem);font-weight:400;line-height:1.05}
    .note-card p{margin:0;color:#514c47;font-size:.92rem}
    .subscribe{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(35px,8vw,115px);align-items:end;margin-top:72px;padding-top:23px;border-top:1px solid var(--ink)}
    .subscribe-copy h3{margin:14px 0 0;font-size:clamp(1.75rem,3vw,3rem);font-weight:400;line-height:1.03;letter-spacing:-.035em}
    .subscribe-form{display:grid;grid-template-columns:1fr auto;gap:0;border-bottom:1px solid var(--ink)}
    .subscribe-form input{min-width:0;padding:17px 8px 17px 0;border:0;background:transparent;color:var(--ink);font:inherit;font-size:1rem;outline:none}
    .subscribe-form input::placeholder{color:#6a645d}
    .subscribe-form button{border:0;background:transparent;color:var(--ink);padding:17px 0 17px 25px;cursor:pointer;font-size:.75rem;letter-spacing:.11em;text-transform:uppercase}
    .subscribe-note{grid-column:2;margin:10px 0 0;color:#625d57;font-size:.78rem}

    .profile{padding:clamp(90px,11vw,170px) 0}
    .profile-grid{display:grid;grid-template-columns:minmax(320px,.72fr) minmax(0,1.28fr);gap:clamp(50px,8vw,125px);align-items:start}
    .portrait{height:min(72vw,760px);min-height:580px;overflow:hidden;background:#d4cec6}
    .portrait img{object-position:center}
    .profile-copy h2{margin:22px 0 36px;font-size:clamp(2.8rem,5.4vw,6rem);font-weight:400;line-height:.92;letter-spacing:-.055em}
    .profile-copy>p{margin:0;max-width:760px;font-size:clamp(1.15rem,1.7vw,1.45rem);line-height:1.45;color:#3d3935}
    .profile-facts{display:grid;grid-template-columns:1fr 1fr;margin-top:50px;border-top:1px solid var(--ink)}
    .profile-fact{padding:16px 18px 16px 0;border-bottom:1px solid var(--line);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
    .career{margin-top:50px;border-top:1px solid var(--ink)}
    .career summary{cursor:pointer;list-style:none;padding:18px 0;display:flex;justify-content:space-between;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
    .career summary::-webkit-details-marker{display:none}.career summary:after{content:"+";font-size:1.3rem}.career[open] summary:after{content:"−"}
    .career-row{display:grid;grid-template-columns:130px 1fr 1.2fr;gap:25px;padding:18px 0;border-top:1px solid var(--line)}
    .career-row small{color:var(--muted);font-size:.75rem}.career-row h3{margin:0;font-size:1rem;font-weight:500}.career-row p{margin:0;color:#514c47;font-size:.9rem}

    .contact{background:var(--accent);color:#fff;padding:clamp(86px,10vw,150px) 0 32px}
    .contact .kicker{color:#f0c7bb}
    .contact-grid{display:grid;grid-template-columns:1.35fr .65fr;align-items:end;gap:60px}
    .contact h2{margin:20px 0 0;font-size:clamp(4rem,9.5vw,10rem);font-weight:400;line-height:.8;letter-spacing:-.07em}
    .contact h2 em{display:block;font-family:Georgia,"Times New Roman",serif;font-weight:400;color:#35140c}
    .contact-links a{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:17px 0;border-bottom:1px solid rgba(255,255,255,.48);font-size:1rem}
    .contact-links a:first-child{border-top:1px solid rgba(255,255,255,.48)}
    .contact-links span{transition:transform .2s}.contact-links a:hover span{transform:translate(3px,-3px)}
    .contact-form-wrap{display:grid;grid-template-columns:.65fr 1.35fr;gap:60px;margin-top:82px;padding-top:24px;border-top:1px solid rgba(255,255,255,.4)}
    .contact-form-wrap h3{margin:14px 0 0;font-size:clamp(1.6rem,2.8vw,2.7rem);font-weight:400;line-height:1.08}
    .contact-form{display:grid;grid-template-columns:1fr 1fr;gap:22px 18px}
    .field{display:flex;flex-direction:column;gap:8px}.field-full{grid-column:1/-1}
    .field label{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#f4d2c8}
    .field input,.field textarea{width:100%;border:0;border-bottom:1px solid rgba(255,255,255,.62);border-radius:0;padding:12px 0;background:transparent;color:white;font:inherit;outline:none}
    .field textarea{min-height:92px;resize:vertical}.field input::placeholder,.field textarea::placeholder{color:rgba(255,255,255,.65)}
    .field input:focus,.field textarea:focus{border-bottom-color:white}
    .contact-submit{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:8px;padding:16px 0;border:0;border-top:1px solid rgba(255,255,255,.62);border-bottom:1px solid rgba(255,255,255,.62);background:transparent;color:white;cursor:pointer;font:inherit;text-align:left}
    .contact-submit span{font-size:.75rem;letter-spacing:.11em;text-transform:uppercase}.contact-form-note{grid-column:1/-1;margin:0;color:#f3c8bc;font-size:.78rem}
    .footer{display:flex;justify-content:space-between;gap:25px;margin-top:100px;padding-top:20px;border-top:1px solid rgba(255,255,255,.35);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}

    :focus-visible{outline:2px solid currentColor;outline-offset:5px}
    @media (max-width:980px){
      .desktop-nav{display:none}.mobile-menu{display:block}.mobile-menu>summary{list-style:none;cursor:pointer;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}.mobile-menu>summary::-webkit-details-marker{display:none}
      .mobile-panel{position:fixed;inset:72px 0 0;background:var(--paper);padding:45px var(--pad);display:flex;flex-direction:column;gap:0}
      .mobile-panel a{padding:18px 0;border-bottom:1px solid var(--line);font-size:1.5rem;letter-spacing:-.02em}
      .hero-bottom,.manifesto-copy,.project-summary,.furniture-lead,.notebook-head,.notebook-intro,.profile-grid,.contact-grid,.mid-cta-inner,.contact-form-wrap{grid-template-columns:1fr}
      .hero-note{max-width:440px}.project-heading{grid-template-columns:55px 1fr}.project-tag{grid-column:2}.furniture-services{grid-template-columns:1fr}.furniture-service{min-height:220px}
      .note-grid{grid-template-columns:1fr}.note-card{min-height:230px}.subscribe{grid-template-columns:1fr}.subscribe-note{grid-column:1}
      .profile-grid{gap:58px}.portrait{height:680px;min-height:0}.contact-links{margin-top:30px}
    }
    @media (max-width:680px){
      :root{--pad:18px}.nav-inner{height:64px}.mobile-panel{inset:64px 0 0}.brand{font-size:.72rem}
      .hero,.hero-inner{min-height:760px}.hero-inner{padding-top:110px;padding-bottom:32px}.hero-top span:last-child{display:none}.hero h1{font-size:clamp(3.7rem,18vw,6.2rem)}.hero-bottom{gap:24px;margin-top:36px}.hero-note{font-size:.88rem}
      .manifesto-grid{grid-template-columns:1fr;gap:26px}.manifesto h2{font-size:3.15rem}.manifesto-copy{margin-top:42px;gap:25px}
      .work-head{display:block}.work-head p{margin-top:25px}.project{padding-top:20px}.project-heading{grid-template-columns:38px 1fr;gap:12px}.project h3{font-size:3.3rem}.project-tag{padding-top:0}.project-cover{aspect-ratio:4/3}.project-summary{gap:34px;padding-top:28px}.project-data{grid-template-columns:1fr}.datum:nth-child(odd){padding-right:0}
      .case-intro,.technical-grid,.story-grid,.credibility-grid,.project-gallery,.project-gallery-label{grid-template-columns:1fr}.case-intro{gap:18px}.story-item{min-height:0}.technical-image{aspect-ratio:1/1}.technical-image img{padding:9px}.project-gallery-label{gap:10px;margin-top:42px}.project-gallery figure:first-child{grid-column:auto}
      .furniture h2{font-size:4rem}.furniture-lead{margin-top:52px}.furniture-services{margin-top:52px}.furniture-list{grid-template-columns:1fr;gap:12px}
      .notebook h2{font-size:4rem}.notebook-intro{margin:45px 0 52px}.subscribe{margin-top:52px}.subscribe-form{grid-template-columns:1fr}.subscribe-form button{padding:16px 0;text-align:left;border-top:1px solid rgba(16,15,14,.35)}
      .portrait{height:520px}.profile-facts{grid-template-columns:1fr}.career-row{grid-template-columns:1fr;gap:6px}.career-row p{margin-top:5px}
      .contact h2{font-size:4.6rem}.footer{margin-top:70px;flex-direction:column;gap:8px}
      .contact-form{grid-template-columns:1fr}.field-full,.contact-submit,.contact-form-note{grid-column:1}
    }
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}

    /* Dirección visual inspirada en la calma material de Norm Architects. */
    :root{--ink:#25221f;--paper:#f5f1e8;--soft:#e9e3d8;--accent:#98523d;--muted:#777068;--line:#d5cec2;--max:1540px}
    body{font-weight:400;letter-spacing:.012em}
    .site-nav{position:absolute;background:transparent;border:0;backdrop-filter:none;color:#fff}
    .nav-inner{height:96px}
    .brand{font-size:.72rem;font-weight:500;letter-spacing:.22em}
    .desktop-nav{gap:38px;font-size:.68rem;letter-spacing:.2em}
    .nav-contact{padding:8px 0!important;border:0}

    .hero,.hero-inner{min-height:100svh}
    .hero-media:after{background:linear-gradient(180deg,rgba(18,15,12,.28) 0%,rgba(18,15,12,.02) 43%,rgba(18,15,12,.52) 100%)}
    .hero-media img{object-position:center center}
    .hero-inner{padding-top:130px;padding-bottom:48px;justify-content:flex-end}
    .hero-top{display:none}
    .hero-copy{width:min(840px,100%);max-width:none;margin:0 auto;text-align:center}
    .hero h1{max-width:none;font-size:clamp(1.25rem,2.2vw,2rem);font-weight:400;line-height:1.15;letter-spacing:.25em;text-transform:uppercase}
    .hero-bottom{display:block;margin-top:18px}
    .hero-lead{max-width:none;font-size:.72rem;line-height:1.4;letter-spacing:.2em;text-transform:uppercase}
    .hero-note{max-width:620px;margin:14px auto 0;color:rgba(255,255,255,.83);font-family:Georgia,"Times New Roman",serif;font-size:1rem;font-style:italic}
    .hero .text-link{margin-top:24px;font-size:.66rem;letter-spacing:.18em}

    .manifesto{padding:clamp(110px,14vw,220px) 0;border-bottom:0}
    .manifesto-grid{grid-template-columns:170px minmax(0,900px);justify-content:center;gap:clamp(38px,7vw,120px)}
    .manifesto h2{max-width:850px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.35rem,4.5vw,5rem);font-weight:400;line-height:1.05;letter-spacing:-.035em}
    .manifesto h2 em{color:var(--accent)}
    .manifesto-copy{margin-top:54px;gap:70px}
    .manifesto-copy .large{font-size:clamp(1.15rem,1.65vw,1.55rem);line-height:1.35}
    .manifesto-copy p{font-size:.95rem;line-height:1.75}

    .work-head{padding:80px 0 72px;border-top:1px solid var(--line)}
    .work-head h2{margin-top:18px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.3rem,4vw,4.2rem);line-height:1;letter-spacing:-.035em}
    .work-head p{font-size:.88rem;line-height:1.75}
    .project{border-top:0;padding:0 0 clamp(120px,14vw,210px)}
    .project-heading{grid-template-columns:52px minmax(0,1fr) auto;margin-bottom:24px;align-items:end}
    .project-index{font-family:inherit;font-size:.66rem;letter-spacing:.18em;color:var(--muted)}
    .project h3{font-size:clamp(1.25rem,2.2vw,2rem);line-height:1.1;letter-spacing:.08em;text-transform:uppercase}
    .project-tag{padding:0;font-size:.66rem;letter-spacing:.15em}
    .project-cover{aspect-ratio:1.72/1}
    .project-cover img{transition:transform 1.2s cubic-bezier(.22,.61,.36,1),filter .8s ease}
    .project:hover .project-cover img{transform:scale(1.012)}
    .project-summary{grid-template-columns:.9fr 1.1fr;gap:clamp(60px,10vw,160px);padding-top:32px}
    .project-summary .statement{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.25rem,1.9vw,1.75rem);line-height:1.35;letter-spacing:-.01em}
    .project-data{font-size:.86rem}
    .case-file{margin-top:30px;border-color:var(--line)}
    .case-file>summary{font-size:.67rem;letter-spacing:.17em}
    .story-item{background:var(--paper)}
    .technical-image{background:#faf8f3;border-color:var(--line)}

    .mid-cta{background:#ded6c9;color:var(--ink);padding:clamp(82px,9vw,130px) 0}
    .mid-cta .kicker{color:var(--accent)}
    .mid-cta h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.1rem,4vw,4.3rem);line-height:1.06;letter-spacing:-.035em}

    .furniture{background:#27231f;color:var(--paper);padding:clamp(120px,14vw,210px) 0}
    .furniture:before{display:none}
    .furniture h2{max-width:900px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.8rem,5.5vw,6rem);line-height:1;letter-spacing:-.04em}
    .furniture h2 em{color:#c9b29f}
    .furniture-lead{margin-top:90px;border-color:#5a534b}
    .furniture-lead p{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.25rem,1.9vw,1.75rem);line-height:1.4}
    .furniture-services{margin-top:80px;border-left:0;border-color:#5a534b}
    .furniture-service{min-height:230px;padding:26px 0;border-right:0;border-color:#5a534b}
    .furniture-service+ .furniture-service{padding-left:28px;border-left:1px solid #5a534b}
    .furniture-service h3{font-family:Georgia,"Times New Roman",serif;font-size:1.45rem}

    .notebook{background:#e7e0d5;padding:clamp(120px,14vw,210px) 0}
    .notebook:after{content:"NEWSLETTER";color:rgba(37,34,31,.035)}
    .notebook h2{max-width:940px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.8rem,5.2vw,5.8rem);line-height:1;letter-spacing:-.04em}
    .notebook-intro{border-color:#aaa196}
    .note-grid{border-color:#aaa196}
    .note-card{min-height:280px;border-color:#aaa196}
    .note-card h3{font-family:Georgia,"Times New Roman",serif;font-weight:400}
    .subscribe{border-color:#aaa196}

    .profile{padding:clamp(120px,14vw,210px) 0}
    .profile h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.8rem,5.2vw,5.8rem);line-height:1;letter-spacing:-.04em}
    .profile-text .lead{font-family:Georgia,"Times New Roman",serif;line-height:1.45}
    .contact{background:#302a25;padding-top:clamp(110px,13vw,190px)}
    .contact .kicker{color:#c9b29f}
    .contact h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(3.4rem,7vw,7.4rem);line-height:.92;letter-spacing:-.045em}
    .contact h2 em{color:#c9b29f}
    .contact-form-note{color:#c9b29f}

    @media (min-width:981px){
      #centro-ambulatorio .shell,#habitar-el-umbral .shell{width:min(calc(88% - (var(--pad) * 2)),1280px)}
    }
    @media (max-width:980px){
      .site-nav{position:absolute;color:#fff}.nav-inner{height:78px}.mobile-menu>summary{letter-spacing:.16em}
      .mobile-panel{inset:78px 0 0;background:var(--paper);color:var(--ink)}
      .manifesto-grid{grid-template-columns:1fr}
      .furniture-service+.furniture-service{padding-left:0;border-left:0}
    }
    @media (max-width:680px){
      .nav-inner{height:66px}.brand{max-width:190px;white-space:normal;line-height:1.35}.mobile-panel{inset:66px 0 0}
      .hero,.hero-inner{min-height:100svh}.hero-inner{padding-top:100px;padding-bottom:34px}.hero h1{font-size:1.05rem;letter-spacing:.18em}.hero-note{font-size:.92rem}
      .manifesto{padding:96px 0}.manifesto h2{font-size:2.55rem}.manifesto-copy{margin-top:38px}
      .work-head{padding:68px 0 52px}.work-head h2{font-size:2.65rem}
      .project{padding-bottom:112px}.project-heading{grid-template-columns:32px 1fr;gap:10px}.project-tag{grid-column:2}.project h3{font-size:1.25rem;letter-spacing:.06em}.project-cover{aspect-ratio:4/3}
      .project-summary{gap:32px;padding-top:26px}.project-summary .statement{font-size:1.3rem}
      .furniture h2,.notebook h2,.profile h2{font-size:3rem}.contact h2{font-size:4rem}
    }

    /* Archivo y navegación integral */
    .site-nav{position:fixed;background:rgba(245,241,232,.96);color:var(--ink);border-bottom:1px solid rgba(37,34,31,.09);backdrop-filter:blur(14px);transition:background .35s,color .35s,border-color .35s}
    .site-nav.on-hero{background:linear-gradient(180deg,rgba(20,17,14,.28),transparent);color:#fff;border-color:transparent;backdrop-filter:none}
    .nav-group{position:relative;display:flex;align-items:center;height:96px}
    .nav-submenu{position:absolute;top:78px;left:50%;width:230px;padding:22px 25px;background:var(--paper);color:var(--ink);border:1px solid var(--line);opacity:0;visibility:hidden;transform:translate(-50%,10px);transition:opacity .22s,transform .22s,visibility .22s;display:flex;flex-direction:column;align-items:flex-start;gap:13px;box-shadow:0 18px 45px rgba(30,25,20,.08)}
    .nav-submenu a{width:100%;padding:0;font-size:.64rem;letter-spacing:.14em;line-height:1.5}
    .nav-group:hover .nav-submenu,.nav-group:focus-within .nav-submenu{opacity:1;visibility:visible;transform:translate(-50%,0)}

    #proyectos{padding-bottom:clamp(120px,14vw,210px)}
    .work-head{min-height:56vh;padding-top:150px;padding-bottom:85px;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:0}
    .work-head h2{font-family:inherit;font-size:clamp(1.25rem,2vw,1.8rem);font-weight:400;letter-spacing:.34em;text-transform:uppercase}
    .work-head .kicker{margin-bottom:28px}
    .work-head p{max-width:520px;margin-top:25px;font-family:Georgia,"Times New Roman",serif;font-size:1rem;line-height:1.65}
    .project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:100px 18px;align-items:start}
    .project-grid>.project{min-width:0;padding:0;border:0}
    .project-grid>.project>.shell{width:100%!important;display:flex;flex-direction:column}
    .project-grid .project-cover{order:1;aspect-ratio:.78/1;background:#ded8ce;cursor:pointer}
    .project-grid .project-heading{order:2;display:block;margin:25px 0 0}
    .project-grid .project-index{display:none}
    .project-grid .project h3{font-size:.86rem;line-height:1.35;letter-spacing:.24em}
    .project-grid .project-tag{margin-top:9px;font-size:.61rem;line-height:1.55;letter-spacing:.15em}
    .project-grid .project-summary{order:3;display:block;padding-top:15px}
    .project-grid .project-summary .statement{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:4;font-family:inherit;font-size:.78rem;line-height:1.65;letter-spacing:.005em;color:#514b45}
    .project-grid .project-data{display:flex;flex-wrap:wrap;gap:7px 0;margin-top:20px;border:0}
    .project-grid .datum{display:inline;padding:0;border:0;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .project-grid .datum:nth-child(n+3){display:none}
    .project-grid .datum+ .datum:before{content:" | ";margin:0 9px;color:#aaa197}
    .project-grid .datum small{display:none}
    .project-grid .datum span{font-size:inherit}
    .project-grid .case-file{order:4;margin-top:20px;border-top:1px solid var(--line);border-bottom:0}
    .project-grid .case-file>summary{padding:13px 0;font-size:0}
    .project-grid .case-file>summary:before{content:"Ver proyecto";font-size:.62rem;letter-spacing:.17em}
    .project-grid .case-file[open]>summary:before{content:"Cerrar proyecto"}

    .project-grid>.project:has(.case-file[open]){grid-column:1/-1;padding:72px 0 95px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .project-grid>.project:has(.case-file[open]) .project-cover{aspect-ratio:1.78/1;cursor:default}
    .project-grid>.project:has(.case-file[open]) .project-heading{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:25px;margin-top:35px}
    .project-grid>.project:has(.case-file[open]) h3{font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,4.2vw,4.5rem);letter-spacing:-.035em;text-transform:none}
    .project-grid>.project:has(.case-file[open]) .project-tag{margin:0;padding-bottom:8px;text-align:right}
    .project-grid>.project:has(.case-file[open]) .project-summary{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(60px,10vw,150px);padding-top:38px}
    .project-grid>.project:has(.case-file[open]) .project-summary .statement{display:block;overflow:visible;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.35rem,2vw,1.85rem);line-height:1.45;color:var(--ink)}
    .project-grid>.project:has(.case-file[open]) .project-data{display:grid;grid-template-columns:1fr 1fr;margin-top:0;border-top:1px solid var(--line)}
    .project-grid>.project:has(.case-file[open]) .datum,.project-grid>.project:has(.case-file[open]) .datum:nth-child(n+3){display:block;padding:14px 0;border-bottom:1px solid var(--line);text-transform:none}
    .project-grid>.project:has(.case-file[open]) .datum+ .datum:before{display:none}
    .project-grid>.project:has(.case-file[open]) .datum small{display:block}
    .project-grid>.project:has(.case-file[open]) .datum span{font-size:.86rem}
    .project-grid>.project:has(.case-file[open]) .case-file{margin-top:45px;border-bottom:0}
    .project-grid>.project:has(.case-file[open]) .case-content{padding-top:48px}
    .project-grid>.project:has(.case-file[open]) .case-intro{grid-template-columns:220px minmax(0,760px);justify-content:center;gap:70px;padding-bottom:70px}
    .project-grid>.project:has(.case-file[open]) .case-intro p{font-family:Georgia,"Times New Roman",serif;font-size:1.2rem;line-height:1.65}

    .mobile-panel small{margin-top:25px;padding-bottom:8px;border-bottom:1px solid var(--line);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
    .mobile-panel small:first-child{margin-top:0}
    body:has(.project-grid .case-file[open]) .site-nav:not(.on-hero){box-shadow:0 8px 30px rgba(35,30,25,.05)}

    @media (max-width:980px){
      .nav-group{height:auto}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:80px 18px}
      .project-grid>.project:has(.case-file[open]){grid-column:1/-1}
    }
    @media (max-width:680px){
      .work-head{min-height:44vh;padding-top:120px;padding-bottom:60px}.work-head h2{font-size:1.15rem;letter-spacing:.25em}.work-head p{font-size:.92rem}
      .project-grid{grid-template-columns:1fr;gap:88px}
      .project-grid .project-cover{aspect-ratio:1/1.08}
      .project-grid>.project:has(.case-file[open]){grid-column:1;padding:45px 0 60px}
      .project-grid>.project:has(.case-file[open]) .project-cover{aspect-ratio:4/3}
      .project-grid>.project:has(.case-file[open]) .project-heading{grid-template-columns:1fr;margin-top:26px}.project-grid>.project:has(.case-file[open]) .project-tag{text-align:left;padding:0}
      .project-grid>.project:has(.case-file[open]) .project-summary{grid-template-columns:1fr;gap:30px}
      .project-grid>.project:has(.case-file[open]) .case-intro{grid-template-columns:1fr;gap:18px}
    }

    /* Archivo real de mobiliario */
    .furniture{background:var(--paper);color:var(--ink);padding:0 0 clamp(120px,14vw,210px)}
    .design-archive-head{min-height:54vh;padding:150px 0 85px;display:grid;grid-template-columns:1fr .55fr;align-items:end;gap:70px}
    .design-archive-head h2{margin:22px 0 0;font-family:inherit;font-size:clamp(1.25rem,2vw,1.8rem);font-weight:400;line-height:1.15;letter-spacing:.34em;text-transform:uppercase}
    .design-archive-head p{max-width:520px;margin:0 0 3px;font-family:Georgia,"Times New Roman",serif;font-size:1rem;line-height:1.7;color:#514b45}
    .design-categories{display:flex;flex-wrap:wrap;gap:10px 24px;margin-bottom:48px;padding:15px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
    .design-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:85px 18px}
    .design-card{display:none;min-width:0}
    .design-card:nth-child(7),.design-card:nth-child(8),.design-card-new{display:block}
    .design-media{aspect-ratio:1.42/1;overflow:hidden;background:#c7c7c7}
    .design-media img{object-fit:contain;transition:transform .8s cubic-bezier(.22,.61,.36,1)}
    .design-card:hover .design-media img{transform:scale(1.025)}
    .design-card h3{margin:22px 0 7px;font-size:.82rem;font-weight:400;line-height:1.35;letter-spacing:.22em;text-transform:uppercase}
    .design-card small{display:block;font-size:.6rem;line-height:1.5;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    .furniture .furniture-lead{margin-top:130px;padding-top:28px;border-color:var(--line)}
    .furniture .furniture-lead p{color:var(--ink)}
    .furniture .furniture-lead .side{color:var(--muted)}
    .furniture .furniture-services{border-color:var(--line)}
    .furniture .furniture-service{border-color:var(--line)}
    .furniture .furniture-service+.furniture-service{border-color:var(--line)}
    .furniture .furniture-service small{color:var(--accent)}
    .furniture .furniture-service p{color:var(--muted)}
    .furniture .furniture-list{border-color:var(--line)}
    .furniture .furniture-list p{color:var(--ink)}

    @media (max-width:980px){
      .design-archive-head{grid-template-columns:1fr;min-height:46vh;gap:28px}.design-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:72px 18px}
    }
    @media (max-width:680px){
      .design-archive-head{min-height:42vh;padding:120px 0 58px}.design-archive-head h2{font-size:1.15rem;letter-spacing:.25em}.design-archive-head p{font-size:.92rem}
      .design-categories{margin-bottom:35px;gap:9px 17px}.design-grid{grid-template-columns:1fr;gap:68px}.design-media{aspect-ratio:1.35/1}
      .furniture .furniture-lead{margin-top:95px}
    }

    /* Navegación editorial y portada secuencial */
    .desktop-nav{display:none!important}
    .mobile-menu{display:block!important;position:relative;z-index:52}
    .mobile-menu>summary{display:flex;align-items:center;justify-content:center;width:48px;height:48px;padding:0;list-style:none;cursor:pointer;color:inherit}
    .mobile-menu>summary::-webkit-details-marker{display:none}
    .menu-icon{position:relative;display:inline-block;width:28px;height:20px;font-family:inherit;font-size:0;line-height:0}
    .menu-icon i{position:absolute;left:0;width:28px;height:1.5px;background:currentColor;transform-origin:center}
    .menu-icon-menu i:nth-child(1){top:1px}.menu-icon-menu i:nth-child(2){top:9px}.menu-icon-menu i:nth-child(3){top:17px}
    .menu-icon-close{display:none}
    .menu-icon-close i:nth-child(1){top:9px;transform:rotate(45deg)}.menu-icon-close i:nth-child(2){top:9px;transform:rotate(-45deg)}
    .mobile-menu[open] .menu-icon-menu{display:none}
    .mobile-menu[open] .menu-icon-close{display:block}
    .mobile-menu[open] .mobile-panel{display:grid}
    .mobile-panel{position:fixed;z-index:50;inset:0;display:none;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);align-content:center;gap:40px 8vw;padding:140px var(--pad) 70px;background:#f4f0e6;color:#aaa69f;overflow:auto}
    .menu-primary{display:flex;flex-direction:column;align-items:flex-start;gap:24px}
    .menu-primary>a{font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,5vw,5.7rem);font-weight:400;line-height:1;letter-spacing:.15em;text-transform:uppercase;transition:color .25s}
    .menu-primary>a:hover,.menu-primary>a:focus-visible{color:var(--ink)}
    .menu-secondary{align-self:end;display:grid;grid-template-columns:1fr 1fr;gap:28px 48px;padding-bottom:10px;color:var(--ink)}
    .menu-secondary small{display:block;margin-bottom:7px;color:var(--muted);font-size:.63rem;letter-spacing:.16em;text-transform:uppercase}
    .menu-secondary a{font-family:Georgia,"Times New Roman",serif;font-size:1.05rem}
    .site-nav:has(.mobile-menu[open]){background:#f4f0e6!important;color:var(--ink)!important;border-color:transparent!important;backdrop-filter:none!important}
    .brand{position:relative;z-index:52}

    .hero-media>img{position:absolute;inset:0}
    .hero-slides{position:absolute;inset:0}
    .hero-slide{position:absolute;inset:0;opacity:0;transition:opacity 1s ease,transform 7s ease;transform:scale(1.018)}
    .hero-slide.is-active{opacity:1;transform:scale(1)}
    .hero-arrow{position:absolute;z-index:3;top:50%;display:grid;place-items:center;width:52px;height:70px;border:0;background:transparent;color:#fff;cursor:pointer;transform:translateY(-50%)}
    .hero-arrow .ui-glyph{font-family:Georgia,"Times New Roman",serif;font-size:36px;font-weight:400;line-height:1}
    .hero-arrow-prev{left:clamp(5px,2vw,28px)}
    .hero-arrow-next{right:clamp(5px,2vw,28px)}
    .hero-pagination{position:absolute;z-index:3;left:50%;bottom:22px;display:flex;gap:12px;transform:translateX(-50%)}
    .hero-dot{width:9px;height:9px;padding:0;border:1px solid rgba(255,255,255,.9);border-radius:50%;background:rgba(255,255,255,.25);cursor:pointer;transition:background .25s,transform .25s}
    .hero-dot.is-active{background:#fff;transform:scale(1.18)}
    .hero-copy{transition:opacity .28s ease,transform .28s ease}
    .hero-copy.is-changing{opacity:0;transform:translateY(8px)}

    /* Ficha editorial de mobiliario */
    .design-card{cursor:pointer;outline:none}
    .design-card:focus-visible{outline:1px solid var(--accent);outline-offset:8px}
    .furniture-dialog{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:0;border:0;background:var(--paper);color:var(--ink)}
    .furniture-dialog::backdrop{background:rgba(16,15,14,.45)}
    .furniture-dialog-inner{min-height:100%;background:var(--paper)}
    .furniture-dialog-close{position:fixed;z-index:4;top:22px;right:24px;display:grid;place-items:center;width:52px;height:52px;border:1px solid rgba(255,255,255,.6);border-radius:50%;background:rgba(20,18,16,.18);color:#fff;backdrop-filter:blur(12px);cursor:pointer}
    .furniture-dialog-media{height:min(72vh,820px);min-height:480px;background:#d8d2c8}
    .furniture-dialog-media img{object-fit:cover}
    .furniture-dialog-media.is-contain{background:#e8e2d8}
    .furniture-dialog-media.is-contain img{object-fit:contain;padding:clamp(8px,1.5vw,22px)}
    .design-card.is-contain .design-media{background:#e8e2d8}
    .design-card.is-contain .design-media img{object-fit:contain;padding:6px}
    .furniture-dialog-arrow{position:absolute;z-index:3;top:calc(min(72vh,820px) / 2);display:grid;place-items:center;width:56px;height:72px;border:0;background:transparent;color:#fff;transform:translateY(-50%);cursor:pointer}
    .furniture-dialog-arrow[hidden]{display:none}
    .furniture-dialog-arrow-prev{left:12px}.furniture-dialog-arrow-next{right:12px}
    .furniture-dialog-arrow .ui-glyph{font-family:Georgia,"Times New Roman",serif;font-size:38px;font-weight:400;line-height:1}
    .dialog-close-glyph{font-family:Arial,sans-serif;font-size:34px;font-weight:200;line-height:1}
    .furniture-dialog-dots{position:absolute;z-index:3;left:50%;top:calc(min(72vh,820px) - 34px);display:flex;gap:10px;transform:translateX(-50%)}
    .furniture-dialog-dots:empty{display:none}
    .furniture-dialog-dot{width:8px;height:8px;padding:0;border:1px solid #fff;border-radius:50%;background:rgba(255,255,255,.28);cursor:pointer}
    .furniture-dialog-dot.is-active{background:#fff}
    .furniture-dialog-body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:70px 10vw;padding:clamp(62px,9vw,130px) var(--pad)}
    .furniture-dialog-body h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,5.5vw,6.2rem);font-weight:400;line-height:.95;letter-spacing:.08em;text-transform:uppercase}
    .furniture-dialog-meta{margin:25px 0 0;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
    .furniture-dialog-copy{align-self:end;margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.2rem,1.8vw,1.65rem);line-height:1.55}
    .furniture-dialog-facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);margin-top:18px;border-top:1px solid var(--line)}
    .furniture-dialog-fact{padding:18px 20px 18px 0;border-bottom:1px solid var(--line)}
    .furniture-dialog-fact small{display:block;margin-bottom:5px;color:var(--muted);font-size:.62rem;letter-spacing:.15em;text-transform:uppercase}
    .furniture-dialog-fact span{font-family:Georgia,"Times New Roman",serif;font-size:1rem}
    .furniture-dialog-count{position:absolute;right:var(--pad);top:calc(min(72vh,820px) + 20px);font-size:.65rem;letter-spacing:.18em;color:var(--muted)}
    body:has(.furniture-dialog[open]){overflow:hidden}

    @media (min-width:901px){
      .furniture-dialog-inner{position:relative;display:grid;grid-template-columns:1fr 1fr;width:100%;height:100vh;overflow:hidden}
      .furniture-dialog-media{grid-column:2;grid-row:1;width:100%;height:100vh;min-height:0}
      .furniture-dialog-media.is-contain img{padding:clamp(18px,2.2vw,42px)}
      .furniture-dialog-body{grid-column:1;grid-row:1;display:flex;flex-direction:column;gap:0;height:100vh;padding:clamp(105px,14vh,155px) clamp(42px,4.5vw,92px) 34px;overflow:auto}
      .furniture-dialog-body>div:first-child{text-align:center}
      .furniture-dialog-body h2{font-size:clamp(1.35rem,1.85vw,2.15rem);line-height:1.15;letter-spacing:.035em}
      .furniture-dialog-meta{margin-top:16px;font-size:.58rem;letter-spacing:.19em}
      .furniture-dialog-copy{align-self:stretch;max-width:860px;margin:clamp(48px,7vh,86px) auto 0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(.9rem,1vw,1.08rem);line-height:1.65;text-align:left}
      .furniture-dialog-facts{width:100%;margin-top:auto;padding-top:50px}
      .furniture-dialog-fact span{font-size:.88rem}
      .furniture-dialog-arrow{top:50%}
      .furniture-dialog-arrow-prev{left:calc(50% + 4px)}
      .furniture-dialog-arrow-next{right:4px}
      .furniture-dialog-dots{left:75%;top:auto;bottom:24px}
      .furniture-dialog-count{position:fixed;z-index:3;top:auto;right:calc(50% + 28px);bottom:18px}
    }

    @media (max-width:760px){
      .mobile-panel{grid-template-columns:1fr;align-content:start;padding-top:125px;gap:55px}
      .menu-primary{gap:27px}.menu-primary>a{font-size:clamp(2.15rem,11vw,4rem);letter-spacing:.11em}
      .menu-secondary{align-self:start;grid-template-columns:1fr 1fr}
      .hero-arrow{width:42px}.hero-arrow-prev{left:0}.hero-arrow-next{right:0}.hero-pagination{bottom:18px;gap:10px}.hero-dot{width:8px;height:8px}
      .furniture-dialog-media{height:58vh;min-height:390px}.furniture-dialog-body{grid-template-columns:1fr;gap:38px;padding-top:60px}.furniture-dialog-copy{font-size:1.2rem}.furniture-dialog-count{top:calc(58vh + 18px)}
      .furniture-dialog-arrow{top:29vh}.furniture-dialog-dots{top:calc(58vh - 31px)}.furniture-dialog-facts{grid-template-columns:1fr}.furniture-dialog-fact{padding-right:0}
    }

    /* Menú-archivo visual: arquitectura, diseño, contenido y estudio */
    .mobile-menu[open] .mobile-panel{display:grid}
    .mobile-panel{
      grid-template-columns:190px minmax(0,1fr);
      align-content:stretch;
      gap:18px;
      padding:66px 18px 18px;
      background:#f4f0e6;
      color:var(--ink);
    }
    .menu-index{
      display:flex;
      flex-direction:column;
      gap:28px;
      min-width:0;
      padding:18px 10px 20px 2px;
      overflow:auto;
    }
    .menu-search{
      display:flex;
      align-items:center;
      gap:9px;
      width:max-content;
      font-size:.62rem;
      letter-spacing:.16em;
      text-transform:uppercase;
    }
    .mobile-panel .menu-search{padding:0;border:0;font-size:.62rem;letter-spacing:.16em}
    .menu-search-mark{position:relative;width:14px;height:14px;border:1px solid currentColor;border-radius:50%}
    .menu-search-mark::after{content:"";position:absolute;right:-5px;bottom:-3px;width:7px;height:1px;background:currentColor;transform:rotate(48deg);transform-origin:left center}
    .menu-index-group{display:flex;flex-direction:column;align-items:flex-start;gap:7px}
    .menu-index-group small{
      margin:0 0 4px;
      padding:0;
      border:0;
      color:var(--ink);
      font-family:Georgia,"Times New Roman",serif;
      font-size:.68rem;
      letter-spacing:.18em;
      text-transform:uppercase;
    }
    .menu-index-group a{padding:0;border:0;color:#625f59;font-size:.55rem;line-height:1.35;letter-spacing:.15em;text-transform:uppercase}
    .menu-index-group a:hover,.menu-index-group a:focus-visible{color:var(--accent)}
    .menu-visual-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;min-height:calc(100vh - 84px)}
    .mobile-panel .menu-visual-card{position:relative;min-width:0;padding:0;border:0;overflow:hidden;background:#918b82;color:#fff;font-size:inherit;letter-spacing:normal;isolation:isolate}
    .menu-visual-card::after{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.36),transparent 30%,rgba(0,0,0,.1));pointer-events:none}
    .menu-visual-card img{width:100%;height:100%;object-fit:cover;transition:transform .75s cubic-bezier(.2,.7,.2,1),filter .4s}
    .menu-visual-card-design{background:#b6a58e}
    .menu-visual-card-design img{object-fit:contain;padding:clamp(14px,2.2vw,34px);filter:saturate(.88)}
    .menu-visual-card:hover img,.menu-visual-card:focus-visible img{transform:scale(1.025);filter:saturate(.86)}
    .menu-visual-card span{position:absolute;z-index:2;top:17px;left:17px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(.78rem,1vw,1rem);letter-spacing:.06em;text-transform:uppercase}
    .menu-visual-card em{position:absolute;z-index:2;right:14px;bottom:13px;font-style:normal;font-size:.5rem;letter-spacing:.16em;text-transform:uppercase;opacity:.85}

    @media (max-width:900px){
      .mobile-panel{grid-template-columns:150px minmax(0,1fr);padding-top:66px}
      .menu-visual-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:minmax(310px,1fr)}
    }
    @media (max-width:680px){
      .mobile-panel{display:none;grid-template-columns:1fr;gap:20px;padding:82px 18px 22px}
      .mobile-menu[open] .mobile-panel{display:block}
      .menu-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 22px;padding:8px 0 24px}
      .menu-search{grid-column:1/-1}
      .menu-index-group{gap:6px}
      .menu-index-group small{font-size:.64rem}
      .menu-index-group a{font-size:.52rem}
      .menu-visual-grid{grid-template-columns:1fr;grid-auto-rows:auto;min-height:0;gap:10px}
      .menu-visual-card{aspect-ratio:1.2/1;min-height:0}
      .menu-visual-card span{top:15px;left:15px;font-size:.92rem}
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#proyectos">Saltar al contenido</a>
  <nav class="site-nav" aria-label="Navegación principal">
