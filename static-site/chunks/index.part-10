',
        'data:image/webp;base64,',
        'data:image/webp;base64,',
        'data:image/webp;base64,',
        'data:image/webp;base64,'
      ];
      const camaPlataformaCard = [...document.querySelectorAll('.design-card')].find(card => card.querySelector('h3')?.textContent.trim() === 'Cama Plataforma Biblioteca');
      const camaPlataformaGallery = camaPlataformaCard ? [camaPlataformaCard.querySelector('img').src, ...camaPlataformaDetails] : camaPlataformaDetails;

      const furnitureDialog = document.querySelector('#furniture-dialog');
      const furnitureCards = [comodaCard,mesaCard,mesaBlancaCard,camaPlataformaCard].filter(Boolean);
      const furnitureGalleries = {
        'mesa-paraiso': mesaParaisoGallery,
        'comoda-blanca-paraiso': comodaBlancaParaisoGallery,
        'mesa-paraiso-blanca': mesaBlancaGallery,
        'cama-plataforma-biblioteca': camaPlataformaGallery
      };
      const furnitureDescriptions = {
        'Chicago':'Sistema mural pensado como una composición liviana de guardado y exhibición. La modulación ordena los llenos y vacíos para integrarse al ambiente sin perder presencia.',
        'Dublin':'Biblioteca de desarrollo vertical que combina ritmo, capacidad de guardado y una lectura serena del material. La estructura define una pieza clara y adaptable.',
        'Sistema modular':'Una pieza que reúne guardado y superficie de trabajo dentro de una misma lógica compositiva, pensada para adaptarse a distintas necesidades domésticas.',
        'Burdeos 70':'Rack de proporciones bajas y horizontales, desarrollado para resolver guardado y equipamiento audiovisual con una presencia contenida.',
        'Pie de cama':'Banco de apoyo y guardado que completa el dormitorio desde una escala doméstica, combinando comodidad, capacidad y detalle constructivo.',
        'Cama con guardado':'Sistema de dormitorio que incorpora almacenamiento sin alterar la lectura limpia del volumen principal y aprovecha de manera eficiente el espacio disponible.',
        'Cómoda Blanca Paraíso':'Cómoda de dormitorio concebida como un volumen sereno y preciso. Los frentes en laca blanca construyen una presencia limpia, mientras las gargantas horizontales en madera de paraíso aportan calidez, ritmo y una apertura intuitiva sin herrajes visibles. La modulación de ocho cajones organiza el guardado cotidiano y el zócalo retranqueado aligera visualmente la pieza, haciendo que el cuerpo principal parezca apenas separado del piso.',
        'Mesa de comedor Paraíso':'La mesa se construye desde el contraste entre la calidez expresiva de la madera de paraíso y la precisión del hierro negro. Una tapa de presencia franca se apoya sobre dos bastidores dobles vinculados por un larguero longitudinal: la estructura queda visible, ordena la pieza y le da estabilidad sin volverla pesada. Sus proporciones fueron pensadas para el uso cotidiano y para conservar una presencia serena dentro del comedor.',
        'Mesa Paraíso Blanca':'Mesa de comedor de lenguaje sereno, definida por el contraste entre una tapa blanca continua y una estructura de madera de paraíso. Los apoyos se resuelven como pares de paneles verticales separados por una junta precisa: esa modulación aligera la base y construye un ritmo en ambos extremos. El larguero longitudinal queda retranqueado para sostener la tapa sin competir con la lectura frontal de la pieza.',
        'Cama Plataforma Biblioteca':'Sistema de dormitorio concebido como una pieza continua que reúne descanso, apoyo y exhibición. La base blanca prolonga el perímetro del colchón y contiene una biblioteca baja integrada en tres frentes, haciendo que el guardado forme parte de la arquitectura del mueble. Los nichos revestidos en madera de nogal aportan profundidad, calidez y contraste; su modulación ordena libros y objetos sin recargar el conjunto. La cama deja de ser un volumen aislado para transformarse en una plataforma habitable, serena y funcional.',
        'Mesa de luz 04':'Pieza compacta de dormitorio que concentra superficie de apoyo y guardado en una escala proporcionada al uso cotidiano.',
        'Detroit':'Mesa baja construida como un volumen continuo. Su presencia horizontal acompaña el estar y organiza los objetos sin dominar el espacio.',
        'Atlanta':'Torre de guardado vertical diseñada para concentrar capacidad en una huella reducida y mantener una lectura arquitectónica limpia.',
        'Escritorio Atlanta':'Desarrollo técnico de una estación de trabajo donde diseño, medidas, materiales y lógica de fabricación se definen como partes de una misma pieza.'
      };
      if (furnitureDialog) {
        const dialogImage = furnitureDialog.querySelector('img');
        const dialogMedia = furnitureDialog.querySelector('.furniture-dialog-media');
        const dialogTitle = furnitureDialog.querySelector('h2');
        const dialogMeta = furnitureDialog.querySelector('.furniture-dialog-meta');
        const dialogCopy = furnitureDialog.querySelector('.furniture-dialog-copy');
        const dialogCount = furnitureDialog.querySelector('.furniture-dialog-count');
        const dialogDots = furnitureDialog.querySelector('.furniture-dialog-dots');
        const dialogFacts = furnitureDialog.querySelector('.furniture-dialog-facts');
        const previousImage = furnitureDialog.querySelector('.furniture-dialog-arrow-prev');
        const nextImage = furnitureDialog.querySelector('.furniture-dialog-arrow-next');
        let activeGallery = [];
        let activeGalleryIndex = 0;
        const showFurnitureImage = next => {
          if (!activeGallery.length) return;
          activeGalleryIndex = (next + activeGallery.length) % activeGallery.length;
          dialogImage.src = activeGallery[activeGalleryIndex];
          dialogDots.querySelectorAll('button').forEach((dot,index) => dot.classList.toggle('is-active',index === activeGalleryIndex));
        };
        const openFurniture = (card,index) => {
          const image = card.querySelector('img');
          const name = card.querySelector('h3')?.textContent.trim() || 'Mobiliario';
          activeGallery = furnitureGalleries[card.dataset.gallery] || [image.src];
          dialogMedia.classList.toggle('is-contain',card.classList.contains('is-contain'));
          activeGalleryIndex = 0;
          dialogImage.src = activeGallery[0];
          dialogImage.alt = image.alt;
          dialogTitle.textContent = name;
          dialogMeta.textContent = `Diseño · Mobiliario · ${card.querySelector('small')?.textContent || 'Pieza seleccionada'}`;
          dialogCopy.textContent = furnitureDescriptions[name] || 'Pieza desarrollada desde la proporción, el uso y la materialidad hasta su definición técnica para producción.';
          dialogCount.textContent = `${String(index + 1).padStart(2,'0')} / ${String(furnitureCards.length).padStart(2,'0')}`;
          dialogDots.replaceChildren();
          activeGallery.forEach((source,galleryIndex) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = `furniture-dialog-dot${galleryIndex === 0 ? ' is-active' : ''}`;
            dot.setAttribute('aria-label',`Mostrar imagen ${galleryIndex + 1} de ${activeGallery.length}`);
            dot.addEventListener('click',() => showFurnitureImage(galleryIndex));
            dialogDots.append(dot);
          });
          const multipleImages = activeGallery.length > 1;
          previousImage.hidden = !multipleImages;
          nextImage.hidden = !multipleImages;
          const hasFacts = Boolean(card.dataset.materials);
          dialogFacts.hidden = !hasFacts;
          if (hasFacts) {
            dialogFacts.querySelector('[data-fact="materials"]').textContent = card.dataset.materials;
            dialogFacts.querySelector('[data-fact="dimensions"]').textContent = card.dataset.dimensions;
            dialogFacts.querySelector('[data-fact="structure"]').textContent = card.dataset.structure;
          }
          furnitureDialog.showModal();
          furnitureDialog.scrollTop = 0;
        };
        furnitureCards.forEach((card,index) => {
          card.tabIndex = 0;
          card.setAttribute('role','button');
          card.setAttribute('aria-label',`Abrir ficha de ${card.querySelector('h3')?.textContent || 'mobiliario'}`);
          card.addEventListener('click',() => openFurniture(card,index));
          card.addEventListener('keydown',event => {
            if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openFurniture(card,index); }
          });
        });
        previousImage.addEventListener('click',() => showFurnitureImage(activeGalleryIndex - 1));
        nextImage.addEventListener('click',() => showFurnitureImage(activeGalleryIndex + 1));
        furnitureDialog.querySelector('.furniture-dialog-close')?.addEventListener('click',() => furnitureDialog.close());
        furnitureDialog.addEventListener('click',event => { if (event.target === furnitureDialog) furnitureDialog.close(); });
      }

      document.querySelectorAll('.menu-visual-card[data-menu-source]').forEach(card => {
        const source = document.querySelector(card.dataset.menuSource);
        const image = card.querySelector('img');
        if (source && image) {
          image.src = source.currentSrc || source.src;
          image.width = source.naturalWidth || Number(source.getAttribute('width')) || 900;
          image.height = source.naturalHeight || Number(source.getAttribute('height')) || 1200;
          image.decoding = 'async';
        }
      });

      const mobileMenu = document.querySelector('.mobile-menu');
      mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click',() => mobileMenu.removeAttribute('open')));
      mobileMenu?.addEventListener('toggle',() => mobileMenu.querySelector('summary')?.setAttribute('aria-label',mobileMenu.open ? 'Cerrar menú' : 'Abrir menú'));
    })();
  </script>
</body>
</html>
