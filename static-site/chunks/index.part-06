  <script>
    (() => {
      const nav = document.querySelector('.site-nav');
      const hero = document.querySelector('.hero');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const updateNav = () => nav.classList.toggle('on-hero', window.scrollY < Math.max(80, hero.offsetHeight - 110));
      updateNav();
      window.addEventListener('scroll', updateNav, {passive:true});

      document.querySelectorAll('.project').forEach(project => {
        const cover = project.querySelector('.project-cover');
        const details = project.querySelector('.case-file');
        const title = project.querySelector('h3')?.textContent.trim() || 'proyecto';
        if (!cover || !details) return;
        cover.setAttribute('role','button');
        cover.setAttribute('tabindex','0');
        cover.setAttribute('aria-label',`Abrir proyecto ${title}`);
        cover.setAttribute('aria-expanded',String(details.open));
        const openProject = () => {
          if (details.open) return;
          details.open = true;
          cover.setAttribute('aria-expanded','true');
          requestAnimationFrame(() => project.scrollIntoView({behavior:reduceMotion?'auto':'smooth',block:'start'}));
        };
        cover.addEventListener('click',openProject);
        cover.addEventListener('keydown',event => {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openProject(); }
        });
        details.addEventListener('toggle',() => cover.setAttribute('aria-expanded',String(details.open)));
      });

      const heroMedia = hero.querySelector('.hero-media');
      const heroCopy = hero.querySelector('.hero-copy');
      const originalHero = heroMedia?.querySelector('img');
      const featured = [
        {selector:null,title:'Casa Patio',lead:'Vivienda unifamiliar · 244,80 m²',note:'Luz, vegetación y vida cotidiana organizadas alrededor de un vacío central.',href:'#casa-patio',src:originalHero?.src,alt:originalHero?.alt},
        {selector:'#centro-ambulatorio',title:'Centro Ambulatorio',lead:'Arquitectura para la salud · 1.980 m²',note:'Un edificio legible y humano, organizado por patios, luz natural y recorridos claros.',href:'#centro-ambulatorio'},
        {selector:'#torre-residencial',title:'Torre Residencial',lead:'Vivienda multifamiliar · Densidad urbana',note:'Expansiones privadas, vegetación y un basamento capaz de activar la relación con la ciudad.',href:'#torre-residencial'},
        {selector:'#habitar-el-umbral',title:'Habitar el Umbral',lead:'Vivienda colectiva · La Reja',note:'La planta baja como infraestructura colectiva entre ciudad, comunidad y vida doméstica.',href:'#habitar-el-umbral'}
      ].map(item => {
        const image = item.selector ? document.querySelector(`${item.selector} .project-cover img`) : null;
        return {...item,src:item.src || image?.src,alt:item.alt || image?.alt || item.title};
      }).filter(item => item.src);

      if (heroMedia && originalHero && featured.length > 1) {
        const slides = document.createElement('div');
        slides.className = 'hero-slides';
        featured.forEach((item,index) => {
          const image = document.createElement('img');
          image.className = `hero-slide${index === 0 ? ' is-active' : ''}`;
          image.src = item.src;
          image.alt = item.alt;
          image.decoding = 'async';
          if (index) image.loading = 'lazy';
          slides.append(image);
        });
        heroMedia.replaceChildren(slides);

        const pagination = hero.querySelector('.hero-pagination');
        const dots = featured.map((item,index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `hero-dot${index === 0 ? ' is-active' : ''}`;
          dot.setAttribute('aria-label',`Mostrar ${item.title}`);
          if (index === 0) dot.setAttribute('aria-current','true');
          pagination.append(dot);
          return dot;
        });

        const title = hero.querySelector('h1');
        const lead = hero.querySelector('.hero-lead');
        const note = hero.querySelector('.hero-note');
        const link = hero.querySelector('.text-link');
        let active = 0;
        let timer;
        const show = next => {
          active = (next + featured.length) % featured.length;
          heroCopy.classList.add('is-changing');
          window.setTimeout(() => {
            const item = featured[active];
            title.textContent = item.title;
            lead.textContent = item.lead;
            note.textContent = item.note;
            link.href = item.href;
            slides.querySelectorAll('.hero-slide').forEach((slide,index) => slide.classList.toggle('is-active',index === active));
            dots.forEach((dot,index) => {
              dot.classList.toggle('is-active',index === active);
              if (index === active) dot.setAttribute('aria-current','true'); else dot.removeAttribute('aria-current');
            });
            heroCopy.classList.remove('is-changing');
          },reduceMotion ? 0 : 220);
        };
        const restart = () => {
          window.clearInterval(timer);
          if (!reduceMotion) timer = window.setInterval(() => show(active + 1),6500);
        };
        hero.querySelector('.hero-arrow-prev')?.addEventListener('click',() => { show(active - 1); restart(); });
        hero.querySelector('.hero-arrow-next')?.addEventListener('click',() => { show(active + 1); restart(); });
        dots.forEach((dot,index) => dot.addEventListener('click',() => { show(index); restart(); }));
        hero.addEventListener('mouseenter',() => window.clearInterval(timer));
        hero.addEventListener('mouseleave',restart);
        restart();
      }

      const mesaParaisoGallery = [
        'data:image/webp;base64,',
        'data:image/webp;base64,',
        'data:image/webp;base64,